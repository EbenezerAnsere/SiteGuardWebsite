PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5433/security_app
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173

# Allow scanning localhost/private IPs (only for local testing; keep false in production)
SCAN_ALLOW_PRIVATE_TARGETS=false

# Hosts you have WRITTEN permission to test, scanned without file/DNS verification.
# Comma-separated; *.example.com matches subdomains. Leave empty unless authorized.
SCAN_AUTHORIZED_HOSTS=
